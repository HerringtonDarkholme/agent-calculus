{
  "name": "agent-calculus",
  "version": "0.1.0",
  "description": "A unified framework for AI agent design based on the Entity Calculus",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/cli.ts",
    "cli": "tsx src/cli.ts",
    "test": "vitest",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "ai": "^4.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "oxlint": "^1.39.0",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint"
  }
}
